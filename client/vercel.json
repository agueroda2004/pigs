{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client/browser",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://pigs-production-2ebe.up.railway.app/api/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
